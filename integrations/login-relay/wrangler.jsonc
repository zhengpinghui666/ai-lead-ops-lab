{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clubops-login-relay",
  "main": "relay.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "observability": {"enabled": false},
  "durable_objects": {"bindings": [{"name": "LOGIN_RELAY", "class_name": "LoginRelay"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LoginRelay"]}]
}
